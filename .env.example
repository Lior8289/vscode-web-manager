PUBLIC_BASE_URL=http://localhost:8080
ENV_NETWORK=vscode-manager-net
# Absolute host path where per-environment workspace folders live.
# Default below works out-of-the-box; change to persist workspaces across reboots
# (e.g. /Users/you/Documents/.../vscode-web-manager/workspaces).
HOST_WORKSPACES_ROOT=/tmp/vscode-web-manager-workspaces
OPENVSCODE_IMAGE=gitpod/openvscode-server